{
  "_comment": "NOTE: We do not deploy to Firebase Hosting anymore. Deployments are handled via Git push to Vercel.",
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "otrobonita-mark",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
