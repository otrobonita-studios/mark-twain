      "blocks": [
        {
          "kind": "html",
          "id": "titleblock-div-0",
          "text": "<div class=\"book-title-block\">\r\n        <h1>1911 ENCYCLOPÆDIA BRITANNICA</h1>\r\n        <h2>BY MARK TWAIN</h2>\r\n\r\n    </div>"
        },
        {
          "kind": "html",
          "id": "prologue-div-1",
          "text": "<div class=\"book-text-content\">\r\n        <div class=\"text-center\">\r\n            <p><span>Table of contents</span>\r\n            </p>\r\n        </div>"
        },
        {
          "kind": "html",
          "id": "prologue-table-2",
          "text": "<table style=\"margin-right:auto; margin-left:auto;\">\r\n            <tbody>\r\n                <tr>\r\n                    <td>\r\n                        <p>In each volume:\r\n                        </p>\r\n                        <ul>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Title_page\"\r\n                                    title=\"1911 Encyclopædia Britannica/Title page\">Title page</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Copyright_notice\"\r\n                                    title=\"1911 Encyclopædia Britannica/Copyright notice\">Copyright notice</a> (expired)\r\n                            </li>\r\n                        </ul>\r\n                        <p>In volume 1 only:\r\n                        </p>\r\n                        <ul>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Dedications\"\r\n                                    title=\"1911 Encyclopædia Britannica/Dedications\">Dedications</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Prefatory_Note\"\r\n                                    title=\"1911 Encyclopædia Britannica/Prefatory Note\">Prefatory Note</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Prefatory_Note_to_the_%22Handy_Volume%22_edition_(1915)\"\r\n                                    title='1911 Encyclopædia Britannica/Prefatory Note to the \"Handy Volume\" edition (1915)'>Prefatory\r\n                                    Note to the \"Handy Volume\" edition (1915)</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Editorial_Introduction\"\r\n                                    title=\"1911 Encyclopædia Britannica/Editorial Introduction\">Editorial\r\n                                    Introduction</a></li>\r\n                        </ul>\r\n                        <p>In Index volume only:\r\n                        </p>\r\n                        <ul>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Classified_Table_of_Contents_%E2%80%94_Introduction\"\r\n                                    title=\"1911 Encyclopædia Britannica/Classified Table of Contents — Introduction\">Classified\r\n                                    Table of Contents — Introduction</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Classified_Table_of_Contents\"\r\n                                    title=\"1911 Encyclopædia Britannica/Classified Table of Contents\">Classified Table\r\n                                    of Contents</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Classified_List_of_Articles\"\r\n                                    title=\"1911 Encyclopædia Britannica/Classified List of Articles\">Classified List of\r\n                                    Articles</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Contributors\"\r\n                                    title=\"1911 Encyclopædia Britannica/Contributors\">Contributors</a></li>\r\n                        </ul>\r\n                        <p>List of volumes:\r\n                        </p>\r\n                        <ol>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_1\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 1\">Volume 1: A – Androphagi</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_2\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 2\">Volume 2: Andros – Austria</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_3\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 3\">Volume 3: Austria – Bisectrix</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_4\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 4\">Volume 4: Bishārīn – Calgary</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_5\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 5\">Volume 5: Calhoun – Chatelaine</a>\r\n                            </li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_6\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 6\">Volume 6: Châtelet – Constantine</a>\r\n                            </li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_7\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 7\">Volume 7: Constantine Pavlovich –\r\n                                    Demidov</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_8\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 8\">Volume 8: Demijohn – Edward</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_9\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 9\">Volume 9: Edwardes – Evangelical\r\n                                    Association</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_10\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 10\">Volume 10: Evangelical Church –\r\n                                    Francis Joseph I.</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_11\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 11\">Volume 11: Franciscans – Gibson</a>\r\n                            </li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_12\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 12\">Volume 12: Gichtel – Harmonium</a>\r\n                            </li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_13\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 13\">Volume 13: Harmony –\r\n                                    Hurstmonceaux</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_14\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 14\">Volume 14: Husband – Italic</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_15\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 15\">Volume 15: Italy – Kyshtym</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_16\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 16\">Volume 16: L – Lord Advocate</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_17\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 17\">Volume 17: Lord Chamberlain –\r\n                                    Mecklenburg</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_18\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 18\">Volume 18: Medal – Mumps</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_19\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 19\">Volume 19: Mun – Oddfellows</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_20\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 20\">Volume 20: Ode – Payment of\r\n                                    Members</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_21\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 21\">Volume 21: Payn – Polka</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_22\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 22\">Volume 22: Poll – Reeves</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_23\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 23\">Volume 23: Refectory –\r\n                                    Sainte-Beuve</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_24\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 24\">Volume 24: Sainte-Claire Deville –\r\n                                    Shuttle</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_25\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 25\">Volume 25: Shuválov – Subliminal\r\n                                    Self</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_26\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 26\">Volume 26: Submarine Mines –\r\n                                    Tom-Tom</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_27\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 27\">Volume 27: Tonalite – Vesuvius</a>\r\n                            </li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_28\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 28\">Volume 28: Vetch – Zymotic\r\n                                    Diseases</a></li>\r\n                            <li><a href=\"/wiki/1911_Encyclop%C3%A6dia_Britannica/Volume_29\"\r\n                                    title=\"1911 Encyclopædia Britannica/Volume 29\">Volume 29: Index</a></li>\r\n                        </ol>\r\n                        <p>See also:\r\n                        </p>\r\n                        <ul>\r\n                            <li><a class=\"external text\" href=\"https://archive.org/details/readersguidetoen00londuoft\"\r\n                                    rel=\"nofollow\"><i>The Reader's Guide to the Encyclopaedia Britannica</i></a>, The\r\n                                Encyclopaedia Britannica Company, 1913</li>\r\n                            <li><a href=\"/wiki/Encyclop%C3%A6dia_Britannica,_Ninth_Edition\"\r\n                                    title=\"Encyclopædia Britannica, Ninth Edition\">Encyclopædia Britannica, Ninth\r\n                                    Edition</a></li>\r\n                            <li><a class=\"new\"\r\n                                    href=\"/w/index.php?title=Encyclop%C3%A6dia_Britannica,_Tenth_Edition&amp;action=edit&amp;redlink=1\"\r\n                                    title=\"Encyclopædia Britannica, Tenth Edition (page does not exist)\">1902\r\n                                    Encyclopædia Britannica</a> (10th ed., supplement to the 9th)</li>\r\n                            <li><a href=\"/wiki/1922_Encyclop%C3%A6dia_Britannica\"\r\n                                    title=\"1922 Encyclopædia Britannica\">1922 Encyclopædia Britannica</a> (12th ed.,\r\n                                supplement to the 11th)</li>\r\n                            <li><a class=\"new\"\r\n                                    href=\"/w/index.php?title=1926_Encyclop%C3%A6dia_Britannica&amp;action=edit&amp;redlink=1\"\r\n                                    title=\"1926 Encyclopædia Britannica (page does not exist)\">1926 Encyclopædia\r\n                                    Britannica</a> (13th ed., supplement to the 12th and further supplement to the 11th)\r\n                            </li>\r\n                        </ul>\r\n                    </td>\r\n                </tr>\r\n            </tbody>\r\n        </table>"
        },
        {
          "kind": "p",
          "id": "prologue-p-raw-end",
          "text": "</td>\r\n        </tr>\r\n        </tbody>\r\n        </table>\r\n    </div>"
        }
      ]
    }
