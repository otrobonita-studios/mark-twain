      "blocks": [
        {
          "kind": "html",
          "id": "titleblock-div-0",
          "text": "<div class=\"book-title-block\">\r\n        <h1>COLLIER'S NEW ENCYCLOPEDIA (1921)</h1>\r\n        <h2>BY MARK TWAIN</h2>\r\n\r\n    </div>"
        },
        {
          "kind": "html",
          "id": "prologue-div-1",
          "text": "<div class=\"book-text-content\">\r\n        <div class=\"text-align-center\">\r\n            <p><span>COLLIER'S</span> </p>\r\n            <p><span>NEW</span> </p>\r\n            <p><span><span style=\"color:red\"><span style=\"letter-spacing:0.15em;\">ENCYCLOPEDIA</span> </p>\r\n            <p><span>A LOOSE-LEAF AND SELF-REVISING<br />REFERENCE WORK</span> </p>\r\n            <p>IN TEN VOLUMES WITH 515 ILLUSTRATIONS<br />AND NINETY-SIX MAPS </p>\r\n            <p>P. F. COLLIER &amp; SON COMPANY<br /> New York </p>\r\n            <p> Copyright 1921<br />By P. F. Collier &amp; Son Company </p>\r\n            <p><span>MANUFACTURED IN U. S. A.</span> </p>\r\n        </div>"
        },
