      "blocks": [
        {
          "kind": "html",
          "id": "titleblock-div-0",
          "text": "<div class=\"book-title-block\">\n        <h1>COLLIER'S NEW ENCYCLOPEDIA (1921)</h1>\n        <h2>BY MARK TWAIN</h2>\n\n    </div>"
        },
        {
          "kind": "html",
          "id": "prologue-div-1",
          "text": "<div class=\"book-text-content\">\n        <div class=\"text-align-center\">\n            <p><span>COLLIER'S</span> </p>\n            <p><span>NEW</span> </p>\n            <p><span><span style=\"color:red\"><span style=\"letter-spacing:0.15em;\">ENCYCLOPEDIA</span> </p>\n            <p><span>A LOOSE-LEAF AND SELF-REVISING<br />REFERENCE WORK</span> </p>\n            <p>IN TEN VOLUMES WITH 515 ILLUSTRATIONS<br />AND NINETY-SIX MAPS </p>\n            <p>P. F. COLLIER &amp; SON COMPANY<br /> New York </p>\n            <p> Copyright 1921<br />By P. F. Collier &amp; Son Company </p>\n            <p><span>MANUFACTURED IN U. S. A.</span> </p>\n        </div>"
        },
        {
          "kind": "p",
          "id": "prologue-p-raw-end",
