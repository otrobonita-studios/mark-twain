      "blocks": [
        {
          "kind": "html",
          "id": "titleblock-div-0",
          "text": "<div class=\"book-title-block\">\r\n        <h1>THE NEW INTERNATIONAL ENCYCLOPÆDIA</h1>\r\n        <h2>BY MARK TWAIN</h2>\r\n\r\n    </div>"
        },
        {
          "kind": "html",
          "id": "prologue-div-1",
          "text": "<div class=\"book-text-content\">\r\n        <div class=\"text-center\">\r\n            <p><span><a class=\"mw-file-description\" href=\"/wiki/File:NIE_1905_Frontispiece_-_The_World.jpg\"><img\r\n                            class=\"mw-file-element\" decoding=\"async\" height=\"377\"\r\n                            src=\"//upload.wikimedia.org/wikipedia/commons/thumb/7/7c/NIE_1905_Frontispiece_-_The_World.jpg/960px-NIE_1905_Frontispiece_-_The_World.jpg?utm_source=en.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\"\r\n                            srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/7/7c/NIE_1905_Frontispiece_-_The_World.jpg/1920px-NIE_1905_Frontispiece_-_The_World.jpg?utm_source=en.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\"\r\n                            width=\"700\" /></a></span>\r\n            </p>\r\n            <p>\r\n                <span><b>Volumes</b></span>\r\n            </p>\r\n        </div>"
        },
        {
          "kind": "html",
          "id": "prologue-table-2",
          "text": "<table style=\"margin:auto;\">\r\n            <tbody>\r\n                <tr>\r\n                    <td>\r\n                        <ol>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_I_A_-_Aristogoras\"\r\n                                    title=\"The New International Encyclopædia/Volume I A - Aristogoras\">I A -\r\n                                    Aristogoras</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_II_Aristarchus_-_Bessi%C3%A8res\"\r\n                                    title=\"The New International Encyclopædia/Volume II Aristarchus - Bessières\">II\r\n                                    Aristarchus - Bessières</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_III_Bessus_-_Cairns\"\r\n                                    title=\"The New International Encyclopædia/Volume III Bessus - Cairns\">III Bessus -\r\n                                    Cairns</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_IV_Cairo_-_Classification_of_Ships\"\r\n                                    title=\"The New International Encyclopædia/Volume IV Cairo - Classification of Ships\">IV\r\n                                    Cairo - Classification of Ships</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_V_Classis_-_Da_Vinci\"\r\n                                    title=\"The New International Encyclopædia/Volume V Classis - Da Vinci\">V Classis -\r\n                                    Da Vinci</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_VI_Davioud_-_Ellery\"\r\n                                    title=\"The New International Encyclopædia/Volume VI Davioud - Ellery\">VI Davioud -\r\n                                    Ellery</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_VII_Ellesmere_-_Fontanel\"\r\n                                    title=\"The New International Encyclopædia/Volume VII Ellesmere - Fontanel\">VII\r\n                                    Ellesmere - Fontanel</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_VIII_Fontanes_-_Goethe\"\r\n                                    title=\"The New International Encyclopædia/Volume VIII Fontanes - Goethe\">VIII\r\n                                    Fontanes - Goethe</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_IX_Goethite_-_Heritable_Jurisdictions\"\r\n                                    title=\"The New International Encyclopædia/Volume IX Goethite - Heritable Jurisdictions\">IX\r\n                                    Goethite - Heritable Jurisdictions</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_X_Herjulfson_-_Ishpeming\"\r\n                                    title=\"The New International Encyclopædia/Volume X Herjulfson - Ishpeming\">X\r\n                                    Herjulfson - Ishpeming</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XI_Ishtar_-_Latitudinarians\"\r\n                                    title=\"The New International Encyclopædia/Volume XI Ishtar - Latitudinarians\">XI\r\n                                    Ishtar - Latitudinarians</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XII_Latium_-_Manna\"\r\n                                    title=\"The New International Encyclopædia/Volume XII Latium - Manna\">XII Latium -\r\n                                    Manna</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XIII_Manna-Croup_-_Morganatic_Marriage\"\r\n                                    title=\"The New International Encyclopædia/Volume XIII Manna-Croup - Morganatic Marriage\">XIII Manna-Croup - Morganatic Marriage</a>\r\n                            </li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XIV_Morgan_City_-_Omul\"\r\n                                    title=\"The New International Encyclopædia/Volume XIV Morgan City - Omul\">XIV Morgan\r\n                                    City - Omul</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XV_Ona_-_Pickering\"\r\n                                    title=\"The New International Encyclopædia/Volume XV Ona - Pickering\">XV Ona -\r\n                                    Pickering</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XVI_Pickersgill_-_Reid\"\r\n                                    title=\"The New International Encyclopædia/Volume XVI Pickersgill - Reid\">XVI\r\n                                    Pickersgill - Reid</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XVII_Reifferscheid_-_Servian_Wall\"\r\n                                    title=\"The New International Encyclopædia/Volume XVII Reifferscheid - Servian Wall\">XVII\r\n                                    Reifferscheid - Servian Wall</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XVIII_Service-berry_-_Tagus\"\r\n                                    title=\"The New International Encyclopædia/Volume XVIII Service-berry - Tagus\">XVIII\r\n                                    Service-berry - Tagus</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XIX_Taharka_-_Vampire\"\r\n                                    title=\"The New International Encyclopædia/Volume XIX Taharka - Vampire\">XIX Taharka\r\n                                    - Vampire</a></li>\r\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XX_Van_-_Zyrians\"\r\n                                    title=\"The New International Encyclopædia/Volume XX Van - Zyrians\">XX Van -\r\n                                    Zyrians</a></li>\r\n                        </ol>\r\n                    </td>\r\n                </tr>\r\n            </tbody>\r\n        </table>"
        },
        {
          "kind": "p",
          "id": "prologue-p-3",
          "text": "<span>"
        },
        {
          "kind": "html",
          "id": "prologue-table-4",
          "text": "<table style=\"margin:0 auto 0 auto;border-spacing:0;border:1px solid;\">\r\n            <tbody>\r\n                <tr>\r\n                    <td style=\"padding:0;\"> \r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td style=\"padding:0;\"> \r\n                    </td>\r\n                    <td style=\"padding:0;\">\r\n                        <table style=\"border:1px solid;\">\r\n                            <tbody>\r\n                                <tr>\r\n                                    <td class=\"text-align-center\">\r\n                                        <p><span style=\"letter-spacing: 1ex;\"><span>THE NEW\r\n                                        </p>\r\n                                        <p><span style=\"letter-spacing: 1ex;\"><span>INTERNATIONAL\r\n                                        </p>\r\n                                        <p><span style=\"letter-spacing: 1ex;\"><span>ENCYCLOPÆDIA\r\n                                        </p>\r\n                                        <p><span class=\"templateunderlined\"\r\n                                                style=\"text-decoration-line:underline;text-decoration-thickness:auto;text-decoration-style:double;\"><span\r\n                                                    class=\"wst-gap __gap\" style=\"display:inline-block; inline-size:2em\">\r\n                                        </p>\r\n                                        <p>\r\n                                            EDITORS\r\n                                        </p>\r\n                                        <p>DANIEL COIT GILMAN, LL. D.\r\n                                        </p>\r\n                                        <p><span>PRESIDENT OF JOHNS HOPKINS UNIVERSITY (1876-1901)</span>\r\n                                        </p>\r\n                                        <p><span>AFTERWARDS PRESIDENT OF THE CARNEGIE INSTITUTION OF WASHINGTON\r\n                                        </p>\r\n                                        <p>HARRY THURSTON PECK, P<span>H. D., L. H. D.\r\n                                        </p>\r\n                                        <p><span>PROFESSOR IN COLUMBIA UNIVERSITY</span>\r\n                                        </p>\r\n                                        <p>FRANK MOORE COLBY, M. A.\r\n                                        </p>\r\n                                        <p><span>LATE PROFESSOR OF ECONOMICS</span>\r\n                                        </p>\r\n                                        <p><span>IN NEW YORK UNIVERSITY</span>\r\n                                        </p>\r\n                                        <p>\r\n                                            VOLUME I\r\n                                        </p>\r\n                                        <p>\r\n                                            <span>NEW YORK</span>\r\n                                        </p>\r\n                                        <p><span>DODD, MEAD AND COMPANY</span>\r\n                                        </p>\r\n                                        <p><span>1905</span>\r\n                                        </p>\r\n                                    </td>\r\n                                </tr>\r\n                            </tbody>\r\n                        </table>"
        },
        {
          "kind": "p",
          "id": "prologue-p-raw-end",
          "text": "</td>\r\n                    <td style=\"padding:0;\"> \r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td style=\"padding:0;\"> \r\n                    </td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n    </div>"
        }
      ]
