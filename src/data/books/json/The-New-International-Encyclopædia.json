      "blocks": [
        {
          "kind": "html",
          "id": "titleblock-div-0",
          "text": "<div class=\"book-title-block\">\n        <h1>THE NEW INTERNATIONAL ENCYCLOPÆDIA</h1>\n        <h2>BY MARK TWAIN</h2>\n\n    </div>"
        },
        {
          "kind": "html",
          "id": "prologue-div-1",
          "text": "<div class=\"book-text-content\">\n        <div class=\"text-center\">\n            <p><span><a class=\"mw-file-description\" href=\"/wiki/File:NIE_1905_Frontispiece_-_The_World.jpg\"><img\n                            class=\"mw-file-element\" decoding=\"async\" height=\"377\"\n                            src=\"//upload.wikimedia.org/wikipedia/commons/thumb/7/7c/NIE_1905_Frontispiece_-_The_World.jpg/960px-NIE_1905_Frontispiece_-_The_World.jpg?utm_source=en.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\"\n                            srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/7/7c/NIE_1905_Frontispiece_-_The_World.jpg/1920px-NIE_1905_Frontispiece_-_The_World.jpg?utm_source=en.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\"\n                            width=\"700\" /></a></span>\n            </p>\n            <p>\n                <span><b>Volumes</b></span>\n            </p>\n        </div>"
        },
        {
          "kind": "html",
          "id": "prologue-table-2",
          "text": "<table style=\"margin:auto;\">\n            <tbody>\n                <tr>\n                    <td>\n                        <ol>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_I_A_-_Aristogoras\"\n                                    title=\"The New International Encyclopædia/Volume I A - Aristogoras\">I A -\n                                    Aristogoras</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_II_Aristarchus_-_Bessi%C3%A8res\"\n                                    title=\"The New International Encyclopædia/Volume II Aristarchus - Bessières\">II\n                                    Aristarchus - Bessières</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_III_Bessus_-_Cairns\"\n                                    title=\"The New International Encyclopædia/Volume III Bessus - Cairns\">III Bessus -\n                                    Cairns</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_IV_Cairo_-_Classification_of_Ships\"\n                                    title=\"The New International Encyclopædia/Volume IV Cairo - Classification of Ships\">IV\n                                    Cairo - Classification of Ships</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_V_Classis_-_Da_Vinci\"\n                                    title=\"The New International Encyclopædia/Volume V Classis - Da Vinci\">V Classis -\n                                    Da Vinci</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_VI_Davioud_-_Ellery\"\n                                    title=\"The New International Encyclopædia/Volume VI Davioud - Ellery\">VI Davioud -\n                                    Ellery</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_VII_Ellesmere_-_Fontanel\"\n                                    title=\"The New International Encyclopædia/Volume VII Ellesmere - Fontanel\">VII\n                                    Ellesmere - Fontanel</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_VIII_Fontanes_-_Goethe\"\n                                    title=\"The New International Encyclopædia/Volume VIII Fontanes - Goethe\">VIII\n                                    Fontanes - Goethe</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_IX_Goethite_-_Heritable_Jurisdictions\"\n                                    title=\"The New International Encyclopædia/Volume IX Goethite - Heritable Jurisdictions\">IX\n                                    Goethite - Heritable Jurisdictions</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_X_Herjulfson_-_Ishpeming\"\n                                    title=\"The New International Encyclopædia/Volume X Herjulfson - Ishpeming\">X\n                                    Herjulfson - Ishpeming</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XI_Ishtar_-_Latitudinarians\"\n                                    title=\"The New International Encyclopædia/Volume XI Ishtar - Latitudinarians\">XI\n                                    Ishtar - Latitudinarians</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XII_Latium_-_Manna\"\n                                    title=\"The New International Encyclopædia/Volume XII Latium - Manna\">XII Latium -\n                                    Manna</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XIII_Manna-Croup_-_Morganatic_Marriage\"\n                                    title=\"The New International Encyclopædia/Volume XIII Manna-Croup - Morganatic Marriage\">XIII Manna-Croup - Morganatic Marriage</a>\n                            </li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XIV_Morgan_City_-_Omul\"\n                                    title=\"The New International Encyclopædia/Volume XIV Morgan City - Omul\">XIV Morgan\n                                    City - Omul</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XV_Ona_-_Pickering\"\n                                    title=\"The New International Encyclopædia/Volume XV Ona - Pickering\">XV Ona -\n                                    Pickering</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XVI_Pickersgill_-_Reid\"\n                                    title=\"The New International Encyclopædia/Volume XVI Pickersgill - Reid\">XVI\n                                    Pickersgill - Reid</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XVII_Reifferscheid_-_Servian_Wall\"\n                                    title=\"The New International Encyclopædia/Volume XVII Reifferscheid - Servian Wall\">XVII\n                                    Reifferscheid - Servian Wall</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XVIII_Service-berry_-_Tagus\"\n                                    title=\"The New International Encyclopædia/Volume XVIII Service-berry - Tagus\">XVIII\n                                    Service-berry - Tagus</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XIX_Taharka_-_Vampire\"\n                                    title=\"The New International Encyclopædia/Volume XIX Taharka - Vampire\">XIX Taharka\n                                    - Vampire</a></li>\n                            <li><a href=\"/wiki/The_New_International_Encyclop%C3%A6dia/Volume_XX_Van_-_Zyrians\"\n                                    title=\"The New International Encyclopædia/Volume XX Van - Zyrians\">XX Van -\n                                    Zyrians</a></li>\n                        </ol>\n                    </td>\n                </tr>\n            </tbody>\n        </table>"
        },
        {
          "kind": "p",
          "id": "prologue-p-3",
          "text": "<span>"
        },
        {
          "kind": "html",
          "id": "prologue-table-4",
          "text": "<table style=\"margin:0 auto 0 auto;border-spacing:0;border:1px solid;\">\n            <tbody>\n                <tr>\n                    <td style=\"padding:0;\"> \n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"padding:0;\"> \n                    </td>\n                    <td style=\"padding:0;\">\n                        <table style=\"border:1px solid;\">\n                            <tbody>\n                                <tr>\n                                    <td class=\"text-align-center\">\n                                        <p><span style=\"letter-spacing: 1ex;\"><span>THE NEW\n                                        </p>\n                                        <p><span style=\"letter-spacing: 1ex;\"><span>INTERNATIONAL\n                                        </p>\n                                        <p><span style=\"letter-spacing: 1ex;\"><span>ENCYCLOPÆDIA\n                                        </p>\n                                        <p><span class=\"templateunderlined\"\n                                                style=\"text-decoration-line:underline;text-decoration-thickness:auto;text-decoration-style:double;\"><span\n                                                    class=\"wst-gap __gap\" style=\"display:inline-block; inline-size:2em\">\n                                        </p>\n                                        <p>\n                                            EDITORS\n                                        </p>\n                                        <p>DANIEL COIT GILMAN, LL. D.\n                                        </p>\n                                        <p><span>PRESIDENT OF JOHNS HOPKINS UNIVERSITY (1876-1901)</span>\n                                        </p>\n                                        <p><span>AFTERWARDS PRESIDENT OF THE CARNEGIE INSTITUTION OF WASHINGTON\n                                        </p>\n                                        <p>HARRY THURSTON PECK, P<span>H. D., L. H. D.\n                                        </p>\n                                        <p><span>PROFESSOR IN COLUMBIA UNIVERSITY</span>\n                                        </p>\n                                        <p>FRANK MOORE COLBY, M. A.\n                                        </p>\n                                        <p><span>LATE PROFESSOR OF ECONOMICS</span>\n                                        </p>\n                                        <p><span>IN NEW YORK UNIVERSITY</span>\n                                        </p>\n                                        <p>\n                                            VOLUME I\n                                        </p>\n                                        <p>\n                                            <span>NEW YORK</span>\n                                        </p>\n                                        <p><span>DODD, MEAD AND COMPANY</span>\n                                        </p>\n                                        <p><span>1905</span>\n                                        </p>\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>"
        },
        {
          "kind": "p",
          "id": "prologue-p-raw-end",
          "text": "</td>\n                    <td style=\"padding:0;\"> \n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"padding:0;\"> \n                    </td>\n                </tr>\n            </tbody>\n        </table>\n    </div>"
        }
      ]
    }
