rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. CONTACT FORMS (Signals)
    // Allows public users to send messages, but prevents them from 
    // seeing who else has written or editing their message after sending.
    match /signals/{document=**} {
      allow create: if true; 
      allow read, update, delete: if false; 
    }

    // 1.5. NEWSLETTER SUBSCRIBERS (Mark Twain)
    // Allows public users to sign up for the newsletter, but prevents
    // anyone from reading the email list.
    match /subscribers/{document=**} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // 2. FILM GALLERY (Movies)
    // Publicly viewable for your portfolio/site, but only 
    // editable via your Admin tools/Firebase Console.
    match /movies/{document=**} {
      allow read: if true;   
      allow write: if false; 
    }

    // 3. STOCK FOOTAGE (Products)
    // Safe configuration: allows users to browse your catalog 
    // without the risk of anyone modifying prices or items.
    match /products/{document=**} {
      allow read: if true;   
      allow write: if request.auth != null; 
    }

    // 3.5. TWAIN QUOTES (Quote Collector)
    // Allows public reading and backend/collector quote writes.
    match /twain_quotes/{document=**} {
      allow read, write: if true;
    }
    
    // 4. GLOBAL SAFETY (Optional but Recommended)
    // Ensures any new collections you create in the future are 
    // locked by default until you explicitly write rules for them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
